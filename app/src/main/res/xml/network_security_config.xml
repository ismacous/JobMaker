<?xml version="1.0" encoding="utf-8"?>
<!--
  Verrouillage du reseau.

  cleartextTrafficPermitted="false" : aucune requete en HTTP simple ne peut
  partir de l'application, meme si une URL mal formee se glissait dans le code.
  Une cle d'API envoyee en clair est une cle publiee.

  Seules les autorites de certification du systeme sont acceptees, pas celles
  installees par l'utilisateur : cela empeche qu'un certificat ajoute sur le
  telephone -- volontairement ou non -- permette de lire les requetes, donc le
  profil et la cle d'API qui y transitent.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
